POSTGRES_DB=curbo
POSTGRES_USER=curbo_user
# Generate a unique value; never use this placeholder outside local development.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg2://curbo_user:curbo_password@localhost:5432/curbo

ENVIRONMENT=development
AUTH_REQUIRED=false
DATABASE_REQUIRED=false
ALLOW_SAMPLE_DATA=true
# Production requires a random value of at least 32 characters.
# API_KEY=replace-with-a-long-random-api-key
# Production examples:
# CORS_ORIGINS=["https://curbo.example.com"]
# TRUSTED_HOSTS=["curbo.example.com"]
# ALLOW_SAMPLE_DATA=false

BACKEND_PORT=8000
FRONTEND_PORT=5173
ANNOTATION_FILE=data/annotations.json
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false
# Local API-key testing only. Do not embed a shared production key in a browser build.
# VITE_CURBO_API_KEY=

MAP_DEFAULT_LAT=44.0521
MAP_DEFAULT_LNG=-123.0868
MAP_DEFAULT_ZOOM=13
